<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="64dp"
    android:orientation="horizontal"
    android:gravity="center"
    android:background="@color/app_black"
    android:weightSum="5">

    <!-- Home -->
    <FrameLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1">

        <ImageView
            android:id="@+id/navHome"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_nav_home"
            android:tint="@color/app_white"
            android:contentDescription="Home" />
    </FrameLayout>

    <!-- Following -->
    <FrameLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1">

        <ImageView
            android:id="@+id/navFollowing"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_nav_following"
            android:tint="@color/app_white"
            android:contentDescription="Following" />
    </FrameLayout>

    <!-- Create Event -->
    <FrameLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1">

        <ImageView
            android:id="@+id/navCreate"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_nav_create"
            android:tint="@color/knight_yellow"
            android:contentDescription="Create Event" />
    </FrameLayout>

    <!-- Saved Events -->
    <FrameLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1">

        <ImageView
            android:id="@+id/navSaved"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_nav_saved"
            android:tint="@color/app_white"
            android:contentDescription="Saved Events" />
    </FrameLayout>

    <!-- Profile -->
    <FrameLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1">

        <ImageView
            android:id="@+id/navProfile"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_nav_profile"
            android:tint="@color/app_white"
            android:contentDescription="Profile" />
    </FrameLayout>

</LinearLayout>
