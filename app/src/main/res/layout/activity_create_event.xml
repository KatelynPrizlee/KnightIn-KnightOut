<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/app_gray">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@color/app_black"
        android:paddingHorizontal="16dp">

        <TextView
            android:layout_width="48dp"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:text="←"
            android:textColor="@color/knight_yellow"
            android:textSize="32sp"
            android:contentDescription="Back" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Create Event"
            android:textColor="@color/app_white"
            android:textSize="21sp"
            android:textStyle="bold" />

        <Space
            android:layout_width="48dp"
            android:layout_height="1dp" />
    </LinearLayout>

    <!-- Scrollable Form -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp"
            android:focusableInTouchMode="true">

            <!-- Event Type Selection -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:background="@drawable/bg_event_card"
                android:padding="6dp">

                <CheckBox
                    android:id="@+id/checkKnightIn"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Knight-In"
                    android:textColor="@color/app_dark_text"
                    android:textSize="16sp"
                    android:buttonTint="@color/app_black" />

                <CheckBox
                    android:id="@+id/checkKnightOut"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Knight-Out"
                    android:textColor="@color/app_dark_text"
                    android:textSize="16sp"
                    android:buttonTint="@color/app_black" />
            </LinearLayout>

            <!-- Event Name -->
            <EditText
                android:id="@+id/editEventName"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="12dp"
                android:background="@color/app_muted"
                android:hint="Event Name..."
                android:paddingHorizontal="12dp"
                android:textColor="@color/app_dark_text"
                android:textColorHint="#666666"
                android:textSize="16sp"
                android:inputType="textCapSentences" />

            <!-- Course or Activity -->
            <EditText
                android:id="@+id/editCourseActivity"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="10dp"
                android:background="@color/app_muted"
                android:hint="Course/Activity..."
                android:paddingHorizontal="12dp"
                android:textColor="@color/app_dark_text"
                android:textColorHint="#666666"
                android:textSize="16sp"
                android:inputType="textCapSentences" />

            <!-- Description -->
            <EditText
                android:id="@+id/editDescription"
                android:layout_width="match_parent"
                android:layout_height="125dp"
                android:layout_marginTop="10dp"
                android:background="@color/app_muted"
                android:hint="Description..."
                android:gravity="top|start"
                android:padding="12dp"
                android:textColor="@color/app_dark_text"
                android:textColorHint="#666666"
                android:textSize="16sp"
                android:inputType="textMultiLine" />

            <!-- Date and Time -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/editDate"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginEnd="5dp"
                    android:background="@color/app_muted"
                    android:hint="Date..."
                    android:paddingHorizontal="12dp"
                    android:textColor="@color/app_dark_text"
                    android:textColorHint="#666666"
                    android:inputType="date"
                    android:textSize="16sp" />

                <EditText
                    android:id="@+id/editTime"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginStart="5dp"
                    android:background="@color/app_muted"
                    android:hint="Time..."
                    android:paddingHorizontal="12dp"
                    android:textColor="@color/app_dark_text"
                    android:textColorHint="#666666"
                    android:inputType="time"
                    android:textSize="16sp" />
            </LinearLayout>

            <!-- Location -->
            <EditText
                android:id="@+id/editLocation"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="10dp"
                android:background="@color/app_muted"
                android:hint="Location..."
                android:paddingHorizontal="12dp"
                android:textColor="@color/app_dark_text"
                android:textColorHint="#666666"
                android:inputType="textCapWords"
                android:textSize="16sp" />

            <!-- Group Size -->
            <EditText
                android:id="@+id/editGroupSize"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="10dp"
                android:background="@color/app_muted"
                android:hint="Group Size..."
                android:paddingHorizontal="12dp"
                android:textColor="@color/app_dark_text"
                android:textColorHint="#666666"
                android:inputType="number"
                android:textSize="16sp" />

            <!-- Study/Social Vibe -->
            <Spinner
                android:id="@+id/spinnerVibe"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="10dp"
                android:background="@color/app_muted"
                android:entries="@array/vibe_options"
                android:paddingHorizontal="12dp"
                android:contentDescription="Study or social vibe" />

            <!-- Optional Cost -->
            <EditText
                android:id="@+id/editCost"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="10dp"
                android:background="@color/app_muted"
                android:hint="(Optional) Cost..."
                android:paddingHorizontal="12dp"
                android:textColor="@color/app_dark_text"
                android:textColorHint="#666666"
                android:inputType="numberDecimal"
                android:textSize="16sp" />

            <!-- Joining Permissions -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:layout_marginBottom="10dp"
                android:gravity="center"
                android:text="Joining Permissions"
                android:textColor="@color/app_dark_text"
                android:textSize="19sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_event_card"
                android:padding="10dp">

                <CheckBox
                    android:id="@+id/checkAnyone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Anyone"
                    android:textColor="@color/app_dark_text"
                    android:textSize="16sp"
                    android:buttonTint="@color/app_black" />

                <CheckBox
                    android:id="@+id/checkLimitedCapacity"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Limited Capacity"
                    android:textColor="@color/app_dark_text"
                    android:textSize="16sp"
                    android:buttonTint="@color/app_black" />

                <CheckBox
                    android:id="@+id/checkApprovalRequired"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Approval Required"
                    android:textColor="@color/app_dark_text"
                    android:textSize="16sp"
                    android:buttonTint="@color/app_black" />
            </LinearLayout>

            <!-- Create Event Button -->
            <Button
                android:id="@+id/buttonCreateEvent"
                android:layout_width="180dp"
                android:layout_height="50dp"
                android:layout_gravity="center"
                android:layout_marginTop="22dp"
                android:layout_marginBottom="24dp"
                android:backgroundTint="@color/knight_yellow"
                android:text="Create Event"
                android:textColor="@color/app_dark_text"
                android:textSize="16sp"
                android:textAllCaps="false"
                android:textStyle="bold" />

        </LinearLayout>
    </ScrollView>


    <!-- Reusable Bottom Navigation -->
    <include layout="@layout/layout_bottom_navigation" />


</LinearLayout>
