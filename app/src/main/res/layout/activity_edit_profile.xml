<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_gray"
    android:orientation="vertical">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:background="@color/app_black"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp">

        <TextView
            android:id="@+id/btnBack"
            android:layout_width="48dp"
            android:layout_height="match_parent"
            android:clickable="true"
            android:contentDescription="Back"
            android:focusable="true"
            android:gravity="center_vertical"
            android:text="←"
            android:textColor="@color/knight_yellow"
            android:textSize="32sp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Edit Profile"
            android:textColor="@color/app_white"
            android:textSize="21sp"
            android:textStyle="bold" />

        <Space
            android:layout_width="48dp"
            android:layout_height="1dp" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="First Name"
                android:textColor="@color/app_white"
                android:textSize="14sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etFirstName"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_input"
                android:hint="First name"
                android:inputType="textPersonName|textCapWords"
                android:paddingHorizontal="14dp"
                android:textColor="@color/app_dark_text"
                android:textColorHint="#666666"
                android:textSize="16sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="Last Name"
                android:textColor="@color/app_white"
                android:textSize="14sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etLastName"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_input"
                android:hint="Last name"
                android:inputType="textPersonName|textCapWords"
                android:paddingHorizontal="14dp"
                android:textColor="@color/app_dark_text"
                android:textColorHint="#666666"
                android:textSize="16sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="Username"
                android:textColor="@color/app_white"
                android:textSize="14sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etUsername"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_input"
                android:hint="Username"
                android:inputType="textNoSuggestions"
                android:paddingHorizontal="14dp"
                android:textColor="@color/app_dark_text"
                android:textColorHint="#666666"
                android:textSize="16sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="Major"
                android:textColor="@color/app_white"
                android:textSize="14sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etMajor"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_input"
                android:hint="e.g., Computer Science"
                android:inputType="textCapWords"
                android:paddingHorizontal="14dp"
                android:textColor="@color/app_dark_text"
                android:textColorHint="#666666"
                android:textSize="16sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="Year"
                android:textColor="@color/app_white"
                android:textSize="14sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etYear"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_input"
                android:hint="e.g., Junior"
                android:inputType="textCapWords"
                android:paddingHorizontal="14dp"
                android:textColor="@color/app_dark_text"
                android:textColorHint="#666666"
                android:textSize="16sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="Interests (comma-separated)"
                android:textColor="@color/app_white"
                android:textSize="14sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etInterests"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_input"
                android:hint="e.g., Gaming, Coding, Movies"
                android:inputType="textCapSentences"
                android:paddingHorizontal="14dp"
                android:textColor="@color/app_dark_text"
                android:textColorHint="#666666"
                android:textSize="16sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="Social Style"
                android:textColor="@color/app_white"
                android:textSize="14sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etSocialStyle"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_input"
                android:hint="e.g., Quiet, Chill"
                android:inputType="textCapSentences"
                android:paddingHorizontal="14dp"
                android:textColor="@color/app_dark_text"
                android:textColorHint="#666666"
                android:textSize="16sp" />

            <ProgressBar
                android:id="@+id/progressBar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginTop="16dp"
                android:indeterminateTint="@color/knight_yellow"
                android:visibility="gone" />

            <Button
                android:id="@+id/btnSaveProfile"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="20dp"
                android:backgroundTint="@color/knight_yellow"
                android:text="Save Profile"
                android:textAllCaps="false"
                android:textColor="@color/app_dark_text"
                android:textSize="17sp"
                android:textStyle="bold" />

        </LinearLayout>
    </ScrollView>

</LinearLayout>
