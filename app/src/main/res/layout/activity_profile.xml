<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/app_gray">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@color/app_black"
        android:paddingHorizontal="16dp">

        <TextView
            android:id="@+id/btnBack"
            android:layout_width="48dp"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:text="←"
            android:textColor="@color/knight_yellow"
            android:textSize="32sp"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="Back"/>

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Profile"
            android:textColor="@color/app_white"
            android:textSize="21sp"
            android:textStyle="bold"/>

        <TextView
            android:id="@+id/btnSettings"
            android:layout_width="48dp"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="⚙"
            android:textSize="29sp"
            android:textColor="@color/app_white"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="Settings"/>

    </LinearLayout>

    <!-- Profile Content -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:padding="16dp">

            <ProgressBar
                android:id="@+id/progressBar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:indeterminateTint="@color/knight_yellow"
                android:visibility="gone" />

            <!-- Profile Picture -->
            <TextView
                android:id="@+id/tvProfileAvatar"
                android:layout_width="110dp"
                android:layout_height="110dp"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_profile_circle"
                android:gravity="center"
                android:text="👤"
                android:textSize="55sp"
                android:contentDescription="Profile picture"/>

            <!-- Display Name -->
            <TextView
                android:id="@+id/tvDisplayName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:text="Loading..."
                android:textColor="@color/app_dark_text"
                android:textSize="23sp"
                android:textStyle="bold"/>

            <!-- Username -->
            <TextView
                android:id="@+id/tvUsername"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:gravity="center"
                android:text=""
                android:textColor="@color/app_dark_text"
                android:textSize="15sp"/>

            <!-- Verification -->
            <TextView
                android:id="@+id/tvVerificationStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center"
                android:text="Not Verified"
                android:textColor="@color/app_dark_text"
                android:textSize="16sp"/>

            <!-- Personal Information Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:orientation="vertical"
                android:background="@drawable/bg_event_card"
                android:padding="18dp">

                <TextView
                    android:id="@+id/tvMajor"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Major: Not set"
                    android:textColor="@color/app_dark_text"
                    android:textSize="17sp"
                    android:textStyle="bold"/>

                <TextView
                    android:id="@+id/tvYear"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="Year: Not set"
                    android:textColor="@color/app_dark_text"
                    android:textSize="17sp"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="Interests:"
                    android:textColor="@color/app_dark_text"
                    android:textSize="17sp"
                    android:textStyle="bold"/>

                <TextView
                    android:id="@+id/tvInterests"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="None added yet"
                    android:textColor="@color/app_dark_text"
                    android:textSize="17sp"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="Social Style:"
                    android:textColor="@color/app_dark_text"
                    android:textSize="17sp"
                    android:textStyle="bold"/>

                <TextView
                    android:id="@+id/tvSocialStyle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Not set"
                    android:textColor="@color/app_dark_text"
                    android:textSize="17sp"/>

                <TextView
                    android:id="@+id/tvHostedCount"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="Hosted: 0 Events"
                    android:textColor="@color/app_dark_text"
                    android:textSize="17sp"/>

            </LinearLayout>

            <!-- Edit Profile Button -->
            <Button
                android:id="@+id/btnEditProfile"
                android:layout_width="180dp"
                android:layout_height="48dp"
                android:layout_gravity="center"
                android:layout_marginTop="20dp"
                android:backgroundTint="@color/knight_yellow"
                android:text="Edit Profile"
                android:textAllCaps="false"
                android:textColor="@color/app_dark_text"
                android:textSize="17sp"
                android:textStyle="bold"/>

            <!-- Log Out Button -->
            <Button
                android:id="@+id/btnLogout"
                android:layout_width="180dp"
                android:layout_height="48dp"
                android:layout_gravity="center"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="16dp"
                android:backgroundTint="@color/app_black"
                android:text="Log Out"
                android:textAllCaps="false"
                android:textColor="@color/app_white"
                android:textSize="16sp"
                android:textStyle="bold"/>

        </LinearLayout>
    </ScrollView>

    <!-- Reusable Bottom Navigation -->
    <include layout="@layout/layout_bottom_navigation" />

</LinearLayout>
