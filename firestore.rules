
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return signedIn()
        && request.auth.uid == userId;
    }

    // USER PROFILES
    match /users/{userId} {

      allow read: if isOwner(userId);

      allow create: if isOwner(userId)
        && request.resource.data.uid == userId;

      allow update: if isOwner(userId)
        && request.resource.data.uid == userId;

      allow delete: if false;
    }

    // EVENTS
    match /events/{eventId} {

      allow read: if signedIn();

      allow create: if signedIn()
        && request.resource.data.eventId == eventId
        && request.resource.data.hostUserId
          == request.auth.uid
        && request.resource.data.eventName is string
        && request.resource.data.eventName.size() > 0
        && request.resource.data.location is string
        && request.resource.data.location.size() > 0
        && request.resource.data.eventType in [
          'KNIGHT_IN', 'KNIGHT_OUT'
        ]
        && request.resource.data.joinType in [
          'OPEN', 'LIMITED', 'APPROVAL'
        ]
        && request.resource.data.status == 'ACTIVE'
        && request.resource.data.participantCount == 0
        && request.resource.data.maxParticipants is int
        && request.resource.data.maxParticipants >= 0
        && (
          request.resource.data.joinType != 'LIMITED'
          || request.resource.data.maxParticipants > 0
        )
        && request.resource.data.cost is number
        && request.resource.data.cost >= 0
        && request.resource.data.startTime is timestamp
        && request.resource.data.endTime is timestamp
        && request.resource.data.startTime > request.time
        && request.resource.data.endTime
          > request.resource.data.startTime;

      // Hosts may cancel their own active events.
      allow update: if signedIn()
        && resource.data.hostUserId == request.auth.uid
        && resource.data.status == 'ACTIVE'
        && request.resource.data.status == 'CANCELLED'
        && request.resource.data.diff(resource.data)
          .affectedKeys().hasOnly(['status']);

      allow delete: if false;
    }

    // DENY EVERYTHING NOT EXPLICITLY ALLOWED
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
